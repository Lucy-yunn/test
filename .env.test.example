# Integration-test environment. Copy to `.env.test.local` (gitignored) and fill in.
#
#   cp .env.test.example .env.test.local
#   npx tsx scripts/setup-local-db.ts configure   # guided: types the local password hidden
#
# Points at the LOCAL PostgreSQL database `ivo_test`, a throwaway database that the test
# migrations and the integration tests own. NEVER the development database, and never a
# remote database: `scripts/resolve-test-db-env.ts` and `scripts/local-db-guard.ts` refuse
# anything that is not localhost / 127.0.0.1 with the database exactly `ivo_test`, and the
# live connection is checked again before any test runs. There is no override.
#
# `scripts/resolve-test-db-env.ts` reads ONLY these variables. A missing
# TEST_DATABASE_URL throws; it never falls back to DATABASE_URL.
# See docs/local-database.md.

# TEST_DATABASE_URL — the local test database.
TEST_DATABASE_URL="postgresql://postgres:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/ivo_test"

# TEST_DIRECT_URL — optional; defaults to TEST_DATABASE_URL. A local PostgreSQL has no
# pooler, so there is no reason to set it. If you do, it must also be the local ivo_test.
# TEST_DIRECT_URL=""
