# Integration-test environment. Copy to `.env.test.local` (gitignored) and fill in.
#
#   cp .env.test.example .env.test.local
#   bash scripts/setup-neon.sh      # guided setup writes TEST_DATABASE_URL
#
# Points at the Neon **test** branch — a throwaway database that migrations and
# integration tests own. NEVER the development or production branch.
#
# `scripts/resolve-test-db-env.ts` reads ONLY these variables. A missing
# TEST_DATABASE_URL throws — it never falls back to DATABASE_URL.

# TEST_DATABASE_URL — the DIRECT (non-pooled) host of the Neon `test` branch.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# TEST_DIRECT_URL — optional; defaults to TEST_DATABASE_URL. Set only if you use a
# pooled TEST_DATABASE_URL and need a separate direct host for `prisma migrate`.
# TEST_DIRECT_URL=""
