# Development environment. Copy to `.env.local` (gitignored) and fill in.
#
#   cp .env.example .env.local
#   bash scripts/setup-neon.sh      # guided setup — writes the values below
#
# `.env.local` points at the Neon **development** branch. NEVER the production branch.
# Integration tests use a separate file — see `.env.test.example`.

# --- Database: Neon `development` branch (ADR-0001) --------------------------
# DATABASE_URL — the POOLED host (…-pooler.…). Used by the app at runtime + Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL — the DIRECT (non-pooled) host. Used by `prisma migrate`.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Better Auth ------------------------------------------------------------
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-32-byte-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# --- Vercel Blob (curated listing photos) -----------------------------------
# Create a Blob store in the Vercel dashboard, then paste its token here.
# Optional until photo upload is built (build step 4).
BLOB_READ_WRITE_TOKEN=""
