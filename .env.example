# Development environment. Copy to `.env.local` (gitignored) and fill in.
#
#   cp .env.example .env.local
#   npx tsx scripts/setup-local-db.ts configure   # guided: types the local password hidden
#
# `.env.local` points at the LOCAL PostgreSQL database `ivo_dev` on this machine. Nothing
# in this workflow may point at a remote database: migrations, the dev seed and the tests
# refuse anything that is not localhost / 127.0.0.1 (scripts/local-db-guard.ts).
# Production values live only in Vercel and never appear in any file here.
# See docs/local-database.md.
# Integration tests use a separate file — see `.env.test.example`.
#
# Paste each connection string EXACTLY ONCE per value (no wrapping quotes, no
# trailing text). `lib/connection-string.ts` rejects a value that contains more
# than one "://" — a sign it was pasted twice.

# --- Database: local PostgreSQL 18, database `ivo_dev` ------------------------
# DATABASE_URL — used by the app at runtime and by Prisma. Local PostgreSQL has no
# connection pooler, so DIRECT_URL is the same address. The host must be 127.0.0.1 or
# localhost and the database must be exactly `ivo_dev`; the guards refuse anything else.
# If the password has odd characters (@ : / # %), let `setup-local-db.ts configure` write
# this file, because it encodes them correctly.
DATABASE_URL="postgresql://postgres:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/ivo_dev"
# DIRECT_URL — used by `prisma migrate`.
DIRECT_URL="postgresql://postgres:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/ivo_dev"

# --- Better Auth ------------------------------------------------------------
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-32-byte-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# --- Staff accounts (docs/auth-and-permissions.md §5) -----------------------
# One named account per founder — `npm run db:seed:staff` creates/updates them
# (idempotent). Add STAFF_3_* etc. and re-run to add a third. Password min 8.
STAFF_1_EMAIL=""
STAFF_1_NAME=""
STAFF_1_PASSWORD=""
STAFF_2_EMAIL=""
STAFF_2_NAME=""
STAFF_2_PASSWORD=""

# --- Vercel Blob (curated listing photos) -----------------------------------
# Create a Blob store in the Vercel dashboard, then paste its token here.
# Optional until photo upload is built (build step 4).
BLOB_READ_WRITE_TOKEN=""
